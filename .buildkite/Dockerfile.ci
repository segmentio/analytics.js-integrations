FROM 018537234677.dkr.ecr.us-east-1.amazonaws.com/docker.io/library/node:22.23.4-alpine3.24

RUN apk update && apk add --no-cache \
      chromium \
      nss \
      freetype \
      harfbuzz \
      ca-certificates \
      ttf-freefont \
      git \
      openssh-client \
      python3 \
      g++ \
      make
